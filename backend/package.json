{
  "name": "routerhub-backend",
  "version": "1.0.0",
  "description": "RouterHub - MikroTik Router Management Dashboard API",
  "main": "server.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node db/seed.js",
    "db:init": "node db/init.js",
    "setup": "node db/init.js && node db/seed.js",
    "migrate": "node db/migrate.js",
    "recover-routers": "node db/recover-router-tunnel.js"
  },
  "keywords": [
    "mikrotik",
    "router",
    "wireguard",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "node-routeros": "^1.6.9",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
